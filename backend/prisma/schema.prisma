generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  nationalId   String   @unique
  phone        String
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenants      Tenant[]
}

model Tenant {
  id              String          @id @default(uuid())
  fullName        String
  nationalId      String?         @unique
  phoneNumber     String?         @unique
  email           String?         @unique
  userId          String?
  user            User?           @relation(fields: [userId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  tenantTenancies TenantTenancy[]
}

model Room {
  id          String    @id @default(uuid())
  name        String    @unique
  capacity    Capacity
  rentAmount  Int?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenancies   Tenancy[]
}

model Tenancy {
  id              String          @id @default(uuid())
  roomId          String
  room            Room            @relation(fields: [roomId], references: [id])
  householdType   HouseHoldType
  status          TenancyStatus
  notes           String?         @db.Text
  startDate       DateTime        @default(now())
  endDate         DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  tenantTenancies TenantTenancy[]

  @@index([roomId, status])
}

model TenantTenancy {
  id        String @id @default(uuid())
  tenantId  String
  tenancyId String

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  tenancy   Tenancy  @relation(fields: [tenancyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenancyId, tenantId])
}

enum Role {
  TENANT
  ADMIN
  USER
}

enum Capacity {
  ONEBEDROOM
  BEDSITTER
  SHOP
}

enum HouseHoldType {
  FAMILY
  SHARED
}

enum TenancyStatus {
  ACTIVE
  ENDED
  TERMINATED
}
