generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  nationalId   String   @unique
  phone        String
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Room {
  id          String   @id @default(uuid())
  name        String   @unique
  capacity    Capacity
  rentAmount  Int?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Role {
  TENANT
  ADMIN
}

enum Capacity {
  ONEBEDROOM
  BEDSITTER
  SHOP
}
