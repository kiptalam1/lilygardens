generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  nationalId   String   @unique
  phone        String
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenants      Tenant[]
}

model Tenant {
  id          String   @id @default(uuid())
  fullName    String
  nationalId  String?
  phoneNumber String
  email       String?  @unique
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Room {
  id          String    @id @default(uuid())
  name        String    @unique
  capacity    Capacity
  rentAmount  Int?
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  tenancies   Tenancy[]
}

model Tenancy {
  id            String        @id @default(uuid())
  roomId        String
  room          Room          @relation(fields: [roomId], references: [id])
  householdType HouseHoldType
  status        TenancyStatus
  notes         String?       @db.Text
  startDate     DateTime      @default(now())
  endDate       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

enum Role {
  TENANT
  ADMIN
  USER
}

enum Capacity {
  ONEBEDROOM
  BEDSITTER
  SHOP
}

enum HouseHoldType {
  FAMILY
  SHARED
}

enum TenancyStatus {
  ACTIVE
  ENDED
  TERMINATED
}
